# Ayu Dark colours for GNU ls/dircolors.
# These use 24-bit ANSI colours; a truecolor terminal is required.
NORMAL 00
FILE 00
RESET 00
DIR 38;2;89;194;255
LINK 38;2;149;230;203
ORPHAN 38;2;240;113;120
MISSING 38;2;240;113;120
FIFO 38;2;210;166;255
SOCK 38;2;210;166;255
BLK 38;2;255;180;84
CHR 38;2;255;180;84
EXEC 38;2;170;217;76
SETUID 38;2;255;143;64
SETGID 38;2;255;143;64
CAPABILITY 38;2;255;143;64
MULTIHARDLINK 00
STICKY_OTHER_WRITABLE 38;2;240;113;120
OTHER_WRITABLE 38;2;255;180;84
STICKY 38;2;255;180;84

# Common file types.
.tar 38;2;255;180;84
.tgz 38;2;255;180;84
.gz 38;2;255;180;84
.zip 38;2;255;180;84
.jpg 38;2;210;166;255
.jpeg 38;2;210;166;255
.png 38;2;210;166;255
.gif 38;2;210;166;255
